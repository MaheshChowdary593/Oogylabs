# The Lenny Growth Assistant Configuration

# Active LLM Provider Choice: ollama | anthropic | openai
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Configuration (Mandatory for Offline Demo)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:latest

# Cloud LLM Credentials (Optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Database Connection
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/lenny_assistant
